Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Global Options:
    Background Color: 35; 38; 43
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
    Color: 100; 105; 115
  - Class: rviz_default_plugins/RobotModel
    Name: Porter
    Enabled: true
    Visual Enabled: true
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Alpha: 1.0
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /scan
      Filter size: 10
    Size (m): 0.04
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 70; 220; 255
    Decay Time: 0.0
  - Class: rviz_default_plugins/Axes
    Name: Camera axes
    Enabled: true
    Reference Frame: camera_link
    Length: 0.25
    Radius: 0.015
  - Acceleration properties:
      Acc. vector alpha: 1
      Acc. vector color: 255; 170; 0
      Acc. vector scale: 0.05
      Derotate acceleration: true
      Enable acceleration: true
    Axes properties:
      Axes scale: 0.4
      Enable axes: true
    Box properties:
      Box alpha: 1
      Box color: 255; 0; 0
      Enable box: false
      x_scale: 1
      y_scale: 1
      z_scale: 1
    Class: rviz_imu_plugin/Imu
    Enabled: true
    Name: IMU orientation and acceleration
    Topic:
      Depth: 10
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /imu
    Value: true
    fixed_frame_orientation: true
  - Class: rviz_default_plugins/Image
    Name: Camera image
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera/image_raw
    Normalize Range: true
  - Class: rviz_default_plugins/Image
    Name: Vest mask
    Enabled: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /target_debug_image
    Normalize Range: true
  - Class: rviz_default_plugins/CameraInfo
    Name: Camera field of view
    Enabled: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera/camera_info
      Filter size: 10
    Far clip: 1.0
    Alpha: 0.15
    Color: 85; 255; 255
    Show edges: true
    Show polygons: false
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.45
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: base_footprint
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Width: 1350
  Height: 900
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
